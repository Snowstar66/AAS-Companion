generator client {
  provider      = "prisma-client-js"
  output        = "../generated/client"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum MembershipRole {
  value_owner
  aida
  aqa
  architect
  delivery_lead
  builder
}

enum OrganizationSide {
  customer
  supplier
}

enum PartyRoleType {
  customer_sponsor
  customer_domain_owner
  value_owner
  architect
  aida
  aqa
  delivery_lead
  builder
  ai_governance_lead
  risk_owner
}

enum AgentType {
  bmad_agent
  governance_agent
  automation_agent
}

enum OutcomeStatus {
  draft
  baseline_in_progress
  ready_for_tg1
  active
}

enum EpicStatus {
  draft
  in_progress
  completed
}

enum StoryType {
  outcome_delivery
  governance
  enablement
}

enum StoryStatus {
  draft
  definition_blocked
  ready_for_handoff
  in_progress
}

enum GovernedObjectOriginType {
  seeded
  native
  imported
}

enum GovernedObjectCreatedMode {
  demo
  clean
  promotion
}

enum GovernedLifecycleState {
  active
  archived
}

enum LineageSourceType {
  artifact_intake_session
  artifact_intake_file
  artifact_aas_candidate
}

enum ArtifactAasCandidateType {
  outcome
  epic
  story
}

enum ArtifactAasMappingState {
  mapped
  uncertain
  missing
}

enum ArtifactComplianceFindingCategory {
  missing
  uncertain
  human_only
  blocked
}

enum ArtifactCandidateReviewStatus {
  pending
  confirmed
  edited
  rejected
  follow_up_needed
  promoted
}

enum ImportedGovernedReadinessState {
  imported
  imported_incomplete
  imported_human_review_needed
  imported_framing_ready
  imported_design_ready
  blocked
  discarded
}

enum TollgateEntityType {
  outcome
  story
}

enum TollgateType {
  tg1_baseline
  story_readiness
}

enum TollgateStatus {
  blocked
  ready
  approved
}

enum SignoffDecisionKind {
  review
  approval
  escalation
}

enum SignoffDecisionStatus {
  approved
  rejected
  changes_requested
}

enum ActivityEntityType {
  organization
  outcome
  epic
  direction_seed
  story
  tollgate
  signoff_record
  party_role_entry
  agent_registry_entry
  artifact_intake_session
  artifact_intake_file
  artifact_aas_candidate
}

enum ActivityEventType {
  demo_seeded
  outcome_created
  outcome_updated
  epic_created
  epic_updated
  direction_seed_created
  direction_seed_updated
  story_created
  story_updated
  tollgate_recorded
  signoff_recorded
  execution_contract_generated
  governed_removal_requested
  governed_hard_deleted
  governed_archived
  governed_restored
  party_role_entry_created
  party_role_entry_updated
  party_role_entry_deactivated
  agent_registry_entry_created
  agent_registry_entry_updated
  agent_registry_entry_deactivated
  artifact_intake_session_created
  artifact_file_uploaded
  artifact_file_rejected
  artifact_candidate_compliance_analyzed
  artifact_candidate_confirmed
  artifact_candidate_edited
  artifact_candidate_rejected
  artifact_candidate_follow_up_marked
  artifact_candidate_issue_disposition_recorded
  artifact_candidate_promoted
  artifact_file_section_disposition_recorded
  artifact_file_carry_forward_applied
  operational_log_recorded
  imported_progression_blocked
  imported_progression_allowed
}

enum ArtifactIntakeSessionStatus {
  uploaded
  source_classification_pending
  source_classified
  parsing_pending
  parsed
  mapping_pending
  human_review_required
  promoted
  blocked
}

enum ArtifactImportIntent {
  framing
  design
}

enum ControlMirrorSourceType {
  current_imports
  manual_artifact_upload
  uploaded_zip
  folder_snapshot
  git_repository_root
}

enum ControlMirrorSourceSupportStatus {
  active
  planned
  unsupported
}

enum ControlMirrorSnapshotStatus {
  scanning
  completed
  blocked
}

enum ControlMirrorArtifactParsingStatus {
  pending
  parsed
  reused
  unreadable
  skipped
}

enum ControlMirrorArtifactLineageStatus {
  traced
  weak
  missing
}

enum ControlMirrorArtifactChangeStatus {
  unchanged
  new
  modified
  deleted
  unreadable
}

enum ControlMirrorNormalizedEvidenceType {
  framing_design_evidence
  architecture_evidence
  journey_ux_evidence
  delivery_story_candidate
  implementation_evidence
  test_evidence
  ai_review_evidence
  ai_risk_ledger
  decision_log
  workflow_log
  final_report
  unknown_evidence
}

enum ControlMirrorStoryClassification {
  framing_story_idea
  candidate_delivery_story
  exploration_story
  epic_candidate
  acceptance_criteria_candidate
  journey_ux_context
  out_of_scope_deferred
  not_story_like
}

enum ControlMirrorStoryReadinessState {
  ready_for_build
  needs_refinement
  deferred
  not_story_like
}

enum ControlMirrorReviewItemState {
  open
  decided
  deferred
  superseded
}

enum ControlMirrorReviewItemSeverity {
  high
  medium
  low
}

enum ControlMirrorReviewRecommendedOption {
  approve
  approve_with_condition
  reject
  defer
  request_change
}

enum ControlMirrorReviewDecisionType {
  approve
  approve_with_controls
  reject
  defer
  downgrade
  request_exception
  request_rework
}

enum ControlMirrorEvidencePackExportFormat {
  json
  markdown
}

enum ControlMirrorEvidencePackExportRetentionState {
  active
  archived
}

enum ControlMirrorEvidencePackExportAcceptanceReviewerRole {
  product_owner
  security_privacy
  aqa
}

enum ControlMirrorEvidencePackExportAcceptanceDecisionType {
  accepted
  accepted_with_conditions
  changes_requested
  revoked
}

enum ArtifactSourceTypeStatus {
  pending
  classified
}

enum ArtifactSourceType {
  bmad_prd
  epic_file
  story_file
  mixed_markdown_bundle
  unknown_artifact
}

enum ExtractionConfidence {
  high
  medium
  low
}

enum RiskProfile {
  low
  medium
  high
}

enum AiAccelerationLevel {
  level_1
  level_2
  level_3
}

model Organization {
  id                           String                        @id
  slug                         String                        @unique
  name                         String
  createdAt                    DateTime                      @default(now())
  updatedAt                    DateTime                      @updatedAt
  memberships                  Membership[]
  outcomes                     Outcome[]
  epics                        Epic[]
  directionSeeds               DirectionSeed[]
  stories                      Story[]
  tollgates                    Tollgate[]
  signoffRecords               SignoffRecord[]
  activityEvents               ActivityEvent[]
  artifactIntakeSessions       ArtifactIntakeSession[]
  artifactIntakeFiles          ArtifactIntakeFile[]
  artifactAasCandidates        ArtifactAasCandidate[]
  controlMirrorSources         ControlMirrorSource[]
  controlMirrorSnapshots       ControlMirrorSnapshot[]
  controlMirrorArtifacts       ControlMirrorArtifact[]
  controlMirrorNormalizedEvidence ControlMirrorNormalizedEvidence[]
  controlMirrorHumanReviewItems ControlMirrorHumanReviewItem[]
  controlMirrorHumanReviewDecisionEvents ControlMirrorHumanReviewDecisionEvent[]
  controlMirrorEvidencePackExports ControlMirrorEvidencePackExport[]
  controlMirrorEvidencePackExportAcceptanceDecisions ControlMirrorEvidencePackExportAcceptanceDecision[]
  controlMirrorEvidencePackExportDownloadEvents ControlMirrorEvidencePackExportDownloadEvent[]
  partyRoleEntries             PartyRoleEntry[]
  agentRegistryEntries         AgentRegistryEntry[]
  governanceRoleRequirements   GovernanceRoleRequirement[]
  governanceRiskCombinationRules GovernanceRiskCombinationRule[]
}

model AppUser {
  id                   String                @id
  email                String                @unique
  fullName             String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  memberships          Membership[]
  ownedOutcomes        Outcome[]             @relation("OutcomeValueOwner")
  tollgateDecisions    Tollgate[]            @relation("TollgateDecisionActor")
  createdSignoffRecords SignoffRecord[]      @relation("SignoffCreator")
  controlMirrorReviewDecisions ControlMirrorHumanReviewDecisionEvent[] @relation("ControlMirrorReviewDecisionActor")
  controlMirrorExportAcceptanceDecisions ControlMirrorEvidencePackExportAcceptanceDecision[] @relation("ControlMirrorExportAcceptanceActor")
  controlMirrorExportDownloadEvents ControlMirrorEvidencePackExportDownloadEvent[] @relation("ControlMirrorExportDownloadActor")
  activityEvents       ActivityEvent[]       @relation("ActivityActor")
  createdIntakeSessions ArtifactIntakeSession[] @relation("ArtifactIntakeSessionCreator")
  uploadedIntakeFiles  ArtifactIntakeFile[]  @relation("ArtifactIntakeFileUploader")
}

model Membership {
  id             String         @id
  organizationId String
  userId         String
  role           MembershipRole
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           AppUser        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([userId, organizationId])
}

model PartyRoleEntry {
  id               String           @id
  organizationId   String
  fullName         String
  email            String
  phoneNumber      String?
  avatarUrl        String?
  organizationSide OrganizationSide
  roleType         PartyRoleType
  roleTitle        String
  mandateNotes     String?
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supervisingAgents AgentRegistryEntry[] @relation("PartyRoleSupervisor")
  signoffRecords   SignoffRecord[]  @relation("ActualSignoffPerson")

  @@index([organizationId, isActive, organizationSide])
  @@index([organizationId, roleType, isActive])
}

model AgentRegistryEntry {
  id                     String         @id
  organizationId         String
  agentName              String
  agentType              AgentType
  purpose                String
  scopeOfWork            String
  allowedArtifactTypes   String[]       @default([])
  allowedActions         String[]       @default([])
  supervisingPartyRoleId String
  isActive               Boolean        @default(true)
  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
  organization           Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supervisingPartyRole   PartyRoleEntry @relation("PartyRoleSupervisor", fields: [supervisingPartyRoleId], references: [id], onDelete: Restrict)

  @@index([organizationId, isActive, agentType])
  @@index([organizationId, supervisingPartyRoleId])
}

model GovernanceRoleRequirement {
  id               String           @id
  organizationId   String
  aiAccelerationLevel AiAccelerationLevel
  organizationSide OrganizationSide
  roleType         PartyRoleType
  minimumCount     Int
  rationale        String
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, aiAccelerationLevel, organizationSide, roleType])
  @@index([organizationId, aiAccelerationLevel])
}

model GovernanceRiskCombinationRule {
  id                 String              @id
  organizationId     String
  aiAccelerationLevel AiAccelerationLevel
  primaryRoleType    PartyRoleType
  conflictingRoleType PartyRoleType
  rationale          String
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, aiAccelerationLevel, primaryRoleType, conflictingRoleType])
  @@index([organizationId, aiAccelerationLevel])
}

model Outcome {
  id                  String              @id
  organizationId      String
  key                 String
  title               String
  framingVersion      Int                 @default(1)
  problemStatement    String?
  outcomeStatement    String?
  baselineDefinition  String?
  baselineSource      String?
  solutionContext     String?
  solutionConstraints String?
  dataSensitivity     String?
  journeyContexts     Json?
  downstreamAiInstructions Json?
  deliveryType        String?
  aiUsageRole         String?
  aiExecutionPattern  String?
  aiUsageIntent       String?
  businessImpactLevel RiskProfile?
  businessImpactRationale String?
  dataSensitivityLevel RiskProfile?
  dataSensitivityRationale String?
  blastRadiusLevel    RiskProfile?
  blastRadiusRationale String?
  decisionImpactLevel RiskProfile?
  decisionImpactRationale String?
  aiLevelJustification String?
  riskAcceptedAt      DateTime?
  riskAcceptedByValueOwnerId String?
  timeframe           String?
  valueOwnerId        String?
  riskProfile         RiskProfile         @default(medium)
  aiAccelerationLevel AiAccelerationLevel @default(level_2)
  status              OutcomeStatus       @default(draft)
  originType          GovernedObjectOriginType @default(native)
  createdMode         GovernedObjectCreatedMode @default(clean)
  lifecycleState      GovernedLifecycleState @default(active)
  archivedAt          DateTime?
  archiveReason       String?
  lineageSourceType   LineageSourceType?
  lineageSourceId     String?
  lineageNote         String?
  importedReadinessState ImportedGovernedReadinessState?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  valueOwner          AppUser?            @relation("OutcomeValueOwner", fields: [valueOwnerId], references: [id], onDelete: SetNull)
  epics               Epic[]
  directionSeeds      DirectionSeed[]
  stories             Story[]

  @@unique([organizationId, key])
  @@index([organizationId, originType])
  @@index([organizationId, lifecycleState])
  @@index([organizationId, createdAt])
  @@index([organizationId, lifecycleState, updatedAt, createdAt])
}

model Epic {
  id             String       @id
  organizationId String
  outcomeId      String
  key            String
  title          String
  purpose        String
  summary        String?
  status         EpicStatus   @default(draft)
  originType     GovernedObjectOriginType @default(native)
  createdMode    GovernedObjectCreatedMode @default(clean)
  lifecycleState GovernedLifecycleState @default(active)
  archivedAt     DateTime?
  archiveReason  String?
  lineageSourceType LineageSourceType?
  lineageSourceId   String?
  lineageNote       String?
  importedReadinessState ImportedGovernedReadinessState?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcome        Outcome      @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  directionSeeds DirectionSeed[]
  stories        Story[]

  @@unique([organizationId, key])
  @@index([organizationId, originType])
  @@index([organizationId, lifecycleState])
  @@index([organizationId, outcomeId, lifecycleState])
  @@index([organizationId, createdAt])
}

model DirectionSeed {
  id                    String              @id
  organizationId        String
  outcomeId             String
  epicId                String
  key                   String
  title                 String
  shortDescription      String
  expectedBehavior      String?
  uxSketchName          String?
  uxSketchContentType   String?
  uxSketchDataUrl       String?
  uxSketches            Json?
  sourceStoryId         String?
  originType            GovernedObjectOriginType @default(native)
  createdMode           GovernedObjectCreatedMode @default(clean)
  lifecycleState        GovernedLifecycleState @default(active)
  archivedAt            DateTime?
  archiveReason         String?
  lineageSourceType     LineageSourceType?
  lineageSourceId       String?
  lineageNote           String?
  importedReadinessState ImportedGovernedReadinessState?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcome               Outcome             @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  epic                  Epic                @relation(fields: [epicId], references: [id], onDelete: Cascade)
  deliveryStories       Story[]             @relation("DirectionSeedToStoryIdeaSource")

  @@unique([organizationId, key])
  @@index([organizationId, outcomeId, lifecycleState])
  @@index([organizationId, epicId, lifecycleState])
  @@index([organizationId, sourceStoryId])
  @@index([organizationId, originType])
  @@index([organizationId, lifecycleState])
  @@index([organizationId, createdAt])
}

model Story {
  id                  String              @id
  organizationId      String
  outcomeId           String
  epicId              String
  key                 String
  title               String
  storyType           StoryType
  valueIntent         String
  expectedBehavior    String?
  uxSketchName        String?
  uxSketchContentType String?
  uxSketchDataUrl     String?
  uxSketches          Json?
  acceptanceCriteria  String[]            @default([])
  aiUsageScope        String[]            @default([])
  aiAccelerationLevel AiAccelerationLevel @default(level_2)
  testDefinition      String?
  definitionOfDone    String[]            @default([])
  sourceDirectionSeedId String?
  status              StoryStatus         @default(draft)
  originType          GovernedObjectOriginType @default(native)
  createdMode         GovernedObjectCreatedMode @default(clean)
  lifecycleState      GovernedLifecycleState @default(active)
  archivedAt          DateTime?
  archiveReason       String?
  lineageSourceType   LineageSourceType?
  lineageSourceId     String?
  lineageNote         String?
  importedReadinessState ImportedGovernedReadinessState?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outcome             Outcome             @relation(fields: [outcomeId], references: [id], onDelete: Cascade)
  epic                Epic                @relation(fields: [epicId], references: [id], onDelete: Cascade)
  sourceDirectionSeed DirectionSeed?      @relation("DirectionSeedToStoryIdeaSource", fields: [sourceDirectionSeedId], references: [id], onDelete: SetNull)

  @@unique([organizationId, key])
  @@index([organizationId, originType])
  @@index([organizationId, lifecycleState])
  @@index([organizationId, createdAt])
  @@index([organizationId, outcomeId, lifecycleState])
  @@index([organizationId, epicId, lifecycleState])
  @@index([organizationId, sourceDirectionSeedId])
}

model Tollgate {
  id             String             @id
  organizationId String
  entityType     TollgateEntityType
  entityId       String
  tollgateType   TollgateType
  status         TollgateStatus     @default(blocked)
  blockers       String[]           @default([])
  approverRoles  MembershipRole[]   @default([])
  submissionVersion Int?
  approvedVersion Int?
  approvalSnapshot Json?
  decidedBy      String?
  decidedAt      DateTime?
  comments       String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionActor  AppUser?           @relation("TollgateDecisionActor", fields: [decidedBy], references: [id], onDelete: SetNull)
  signoffRecords SignoffRecord[]

  @@unique([organizationId, entityType, entityId, tollgateType])
  @@index([organizationId, entityType, entityId])
  @@index([organizationId, entityType, updatedAt])
  @@index([organizationId, entityType, tollgateType, updatedAt])
}

model SignoffRecord {
  id                   String               @id
  organizationId       String
  entityType           TollgateEntityType
  entityId             String
  entityVersion        Int?
  tollgateId           String?
  tollgateType         TollgateType?
  decisionKind         SignoffDecisionKind
  requiredRoleType     PartyRoleType
  actualPartyRoleEntryId String
  actualPersonName     String
  actualPersonEmail    String
  actualRoleTitle      String
  organizationSide     OrganizationSide
  decisionStatus       SignoffDecisionStatus
  note                 String?
  evidenceReference    String?
  createdBy            String?
  createdAt            DateTime             @default(now())
  organization         Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tollgate             Tollgate?            @relation(fields: [tollgateId], references: [id], onDelete: SetNull)
  actualPartyRoleEntry PartyRoleEntry       @relation("ActualSignoffPerson", fields: [actualPartyRoleEntryId], references: [id], onDelete: Restrict)
  creator              AppUser?             @relation("SignoffCreator", fields: [createdBy], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, tollgateId, createdAt])
  @@index([organizationId, decisionKind, decisionStatus])
}

model ActivityEvent {
  id             String             @id
  organizationId String
  entityType     ActivityEntityType
  entityId       String
  eventType      ActivityEventType
  actorId        String?
  metadata       Json?
  createdAt      DateTime           @default(now())
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actor          AppUser?           @relation("ActivityActor", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([organizationId, entityType, entityId])
  @@index([organizationId, createdAt])
  @@index([organizationId, entityType, entityId, createdAt])
  @@index([organizationId, eventType, createdAt])
}

model ArtifactIntakeSession {
  id             String                    @id
  organizationId String
  label          String
  importIntent   ArtifactImportIntent      @default(framing)
  status         ArtifactIntakeSessionStatus @default(uploaded)
  mappedArtifacts Json?
  mappingCompletedAt DateTime?
  createdBy      String?
  createdAt      DateTime                  @default(now())
  updatedAt      DateTime                  @updatedAt
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  creator        AppUser?                  @relation("ArtifactIntakeSessionCreator", fields: [createdBy], references: [id], onDelete: SetNull)
  files          ArtifactIntakeFile[]
  candidates     ArtifactAasCandidate[]

  @@index([organizationId, createdAt])
  @@index([organizationId, status])
  @@index([organizationId, updatedAt, createdAt])
}

model ArtifactIntakeFile {
  id               String                   @id
  intakeSessionId  String
  organizationId   String
  fileName         String
  mimeType         String?
  extension        String
  sizeBytes        Int
  content          String
  sourceTypeStatus ArtifactSourceTypeStatus @default(pending)
  sourceType       ArtifactSourceType?
  sourceTypeConfidence ExtractionConfidence?
  classifiedAt     DateTime?
  parsedAt         DateTime?
  parsedArtifacts  Json?
  sectionDispositions Json?
  uploadedBy       String?
  uploadedAt       DateTime                 @default(now())
  intakeSession    ArtifactIntakeSession    @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploader         AppUser?                 @relation("ArtifactIntakeFileUploader", fields: [uploadedBy], references: [id], onDelete: SetNull)
  candidates       ArtifactAasCandidate[]

  @@index([organizationId, uploadedAt])
  @@index([organizationId, sourceTypeStatus])
  @@index([intakeSessionId])
  @@index([organizationId, intakeSessionId, uploadedAt])
}

model ArtifactAasCandidate {
  id                        String                        @id
  intakeSessionId           String
  fileId                    String
  organizationId            String
  type                      ArtifactAasCandidateType
  title                     String
  summary                   String
  mappingState              ArtifactAasMappingState
  sourceType                ArtifactSourceType
  sourceConfidence          ExtractionConfidence
  sourceSectionId           String
  sourceSectionTitle        String
  sourceSectionMarker       String
  inferredOutcomeCandidateId String?
  inferredEpicCandidateId   String?
  relationshipState         ArtifactAasMappingState
  relationshipNote          String?
  acceptanceCriteria        String[]                      @default([])
  testNotes                 String[]                      @default([])
  draftRecord               Json
  humanDecisions            Json
  complianceResult          Json
  issueDispositions         Json?
  reviewStatus              ArtifactCandidateReviewStatus @default(pending)
  reviewComment             String?
  followUpNeeded            Boolean                       @default(false)
  importedReadinessState    ImportedGovernedReadinessState?
  promotedEntityType        ArtifactAasCandidateType?
  promotedEntityId          String?
  promotedAt                DateTime?
  createdAt                 DateTime                      @default(now())
  updatedAt                 DateTime                      @updatedAt
  organization              Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  intakeSession             ArtifactIntakeSession         @relation(fields: [intakeSessionId], references: [id], onDelete: Cascade)
  file                      ArtifactIntakeFile            @relation(fields: [fileId], references: [id], onDelete: Cascade)

  @@index([organizationId, intakeSessionId])
  @@index([organizationId, fileId])
  @@index([organizationId, reviewStatus])
  @@index([organizationId, intakeSessionId, reviewStatus])
  @@index([organizationId, fileId, reviewStatus])
  @@index([organizationId, updatedAt, createdAt])
}

model ControlMirrorSource {
  id             String                           @id
  organizationId String
  label          String
  sourceType     ControlMirrorSourceType
  supportStatus  ControlMirrorSourceSupportStatus @default(active)
  sourceReference String?
  refreshSupported Boolean                         @default(true)
  createdBy      String?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshots      ControlMirrorSnapshot[]

  @@index([organizationId, updatedAt, createdAt])
  @@index([organizationId, sourceType])
}

model ControlMirrorSnapshot {
  id             String                      @id
  organizationId String
  sourceId       String
  label          String
  status         ControlMirrorSnapshotStatus @default(scanning)
  scanStartedAt  DateTime                    @default(now())
  scanCompletedAt DateTime?
  fileCount      Int                         @default(0)
  unchangedCount Int                         @default(0)
  newCount       Int                         @default(0)
  modifiedCount  Int                         @default(0)
  deletedCount   Int                         @default(0)
  unreadableCount Int                        @default(0)
  summaryJson    Json?
  createdAt      DateTime                    @default(now())
  updatedAt      DateTime                    @updatedAt
  organization   Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  source         ControlMirrorSource         @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  artifacts      ControlMirrorArtifact[]
  normalizedEvidence ControlMirrorNormalizedEvidence[]
  humanReviewItems ControlMirrorHumanReviewItem[]

  @@index([organizationId, updatedAt, createdAt])
  @@index([organizationId, sourceId, scanStartedAt])
  @@index([organizationId, status])
}

model ControlMirrorArtifact {
  id                 String                            @id
  organizationId     String
  snapshotId         String
  sourceFileId       String?
  filePath           String
  fileName           String
  extension          String
  sizeBytes          Int
  sourceHash         String
  lastModifiedAt     DateTime?
  artifactType       String
  parsingStatus      ControlMirrorArtifactParsingStatus @default(pending)
  parsingConfidence  ExtractionConfidence               @default(medium)
  detectedOutcomeKey String?
  detectedEpicKey    String?
  detectedStoryKey   String?
  detectedAiLevel    AiAccelerationLevel?
  lineageStatus      ControlMirrorArtifactLineageStatus
  changeStatus       ControlMirrorArtifactChangeStatus
  sourceExcerpt      String?
  parsedJson         Json?
  createdAt          DateTime                          @default(now())
  updatedAt          DateTime                          @updatedAt
  organization       Organization                      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot           ControlMirrorSnapshot             @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  normalizedEvidence ControlMirrorNormalizedEvidence[]

  @@index([organizationId, snapshotId])
  @@index([organizationId, artifactType])
  @@index([organizationId, lineageStatus])
  @@index([organizationId, changeStatus])
  @@index([organizationId, filePath])
}

model ControlMirrorNormalizedEvidence {
  id                     String                              @id
  organizationId         String
  snapshotId             String
  artifactId             String
  sourceFileId           String?
  evidenceType           ControlMirrorNormalizedEvidenceType
  label                  String
  sourceSection          String
  sourceExcerpt          String?
  storyClassification    ControlMirrorStoryClassification
  readinessState         ControlMirrorStoryReadinessState
  missingReadinessFields String[]
  detectedStoryKey       String?
  lineageJson            Json?
  createdAt              DateTime                            @default(now())
  updatedAt              DateTime                            @updatedAt
  organization           Organization                        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot               ControlMirrorSnapshot               @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  artifact               ControlMirrorArtifact               @relation(fields: [artifactId], references: [id], onDelete: Cascade)

  @@index([organizationId, snapshotId])
  @@index([organizationId, artifactId])
  @@index([organizationId, evidenceType])
  @@index([organizationId, storyClassification])
  @@index([organizationId, readinessState])
}

model ControlMirrorHumanReviewItem {
  id                 String                                 @id
  organizationId     String
  snapshotId         String?
  sourceFindingId    String
  stableFindingKey   String
  severity           ControlMirrorReviewItemSeverity
  category           String
  decisionNeeded     String
  recommendedOption  ControlMirrorReviewRecommendedOption
  affectedObject     String
  affectedOutcomeId  String?
  affectedEpicId     String?
  affectedStoryId    String?
  blocksRelease      Boolean                                @default(false)
  reviewHref         String
  valueRationale     String
  alternatives       String[]                               @default([])
  riskIfApproved     String
  riskIfNotApproved  String
  suggestedResponse  String
  rationale          String
  sourceLineageJson  Json?
  state              ControlMirrorReviewItemState           @default(open)
  lastSeenAt         DateTime                               @default(now())
  createdAt          DateTime                               @default(now())
  updatedAt          DateTime                               @updatedAt
  organization       Organization                           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  snapshot           ControlMirrorSnapshot?                 @relation(fields: [snapshotId], references: [id], onDelete: SetNull)
  decisionEvents     ControlMirrorHumanReviewDecisionEvent[]

  @@unique([organizationId, stableFindingKey])
  @@index([organizationId, state, updatedAt])
  @@index([organizationId, sourceFindingId])
  @@index([organizationId, snapshotId])
  @@index([organizationId, blocksRelease, state])
}

model ControlMirrorHumanReviewDecisionEvent {
  id             String                           @id
  organizationId String
  reviewItemId   String
  decisionType   ControlMirrorReviewDecisionType
  rationale      String
  priorState     ControlMirrorReviewItemState
  resultingState ControlMirrorReviewItemState
  actorId        String
  createdAt      DateTime                         @default(now())
  organization   Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  reviewItem     ControlMirrorHumanReviewItem     @relation(fields: [reviewItemId], references: [id], onDelete: Cascade)
  actor          AppUser                          @relation("ControlMirrorReviewDecisionActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, reviewItemId, createdAt])
  @@index([organizationId, actorId, createdAt])
  @@index([organizationId, decisionType, createdAt])
}

model ControlMirrorEvidencePackExport {
  id             String                                @id
  organizationId String
  snapshotId     String?
  format         ControlMirrorEvidencePackExportFormat
  schemaVersion  String
  fileName       String
  contentType    String
  payload        Json
  markdownContent String?
  generatedAt    DateTime
  createdBy      String?
  createdAt      DateTime                              @default(now())
  retentionState ControlMirrorEvidencePackExportRetentionState @default(active)
  retentionPolicyLabel String                           @default("governance_audit_artifact")
  retentionReviewDueAt DateTime?
  retentionReviewedAt DateTime?
  archivedAt     DateTime?
  archivedBy     String?
  archiveReason  String?
  organization   Organization                          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  acceptanceDecisions ControlMirrorEvidencePackExportAcceptanceDecision[]
  downloadEvents ControlMirrorEvidencePackExportDownloadEvent[]

  @@index([organizationId, createdAt])
  @@index([organizationId, snapshotId, createdAt])
  @@index([organizationId, format, createdAt])
  @@index([organizationId, retentionState, createdAt], map: "cm_export_retention_state_idx")
}

model ControlMirrorEvidencePackExportDownloadEvent {
  id             String                          @id
  organizationId String
  exportId       String
  actorId        String
  createdAt      DateTime                        @default(now())
  organization   Organization                    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  export         ControlMirrorEvidencePackExport @relation(fields: [exportId], references: [id], onDelete: Cascade)
  actor          AppUser                         @relation("ControlMirrorExportDownloadActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, exportId, createdAt], map: "cm_export_download_event_export_idx")
  @@index([organizationId, actorId, createdAt], map: "cm_export_download_event_actor_idx")
}

model ControlMirrorEvidencePackExportAcceptanceDecision {
  id             String                                                    @id
  organizationId String
  exportId       String
  reviewerRole   ControlMirrorEvidencePackExportAcceptanceReviewerRole
  decisionType   ControlMirrorEvidencePackExportAcceptanceDecisionType
  rationale      String
  actorId        String
  createdAt      DateTime                                                  @default(now())
  organization   Organization                                              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  export         ControlMirrorEvidencePackExport                           @relation(fields: [exportId], references: [id], onDelete: Cascade)
  actor          AppUser                                                    @relation("ControlMirrorExportAcceptanceActor", fields: [actorId], references: [id], onDelete: Restrict)

  @@index([organizationId, exportId, createdAt], map: "cm_export_acceptance_export_idx")
  @@index([organizationId, actorId, createdAt], map: "cm_export_acceptance_actor_idx")
  @@index([organizationId, reviewerRole, decisionType], map: "cm_export_acceptance_role_decision_idx")
}
